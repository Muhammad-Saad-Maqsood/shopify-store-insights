{%- assign current_variant = product.selected_or_first_available_variant -%}

<div
  class="store-insights-stock"
  data-store-insights-stock
  data-threshold="{{ block.settings.low_stock_threshold }}"
  data-initial-variant-id="{{ current_variant.id }}"
>
  <p
    class="store-insights-stock__message"
    data-store-insights-stock-message
    aria-live="polite"
  ></p>
</div>

<script type="application/json" data-store-insights-stock-variants>
  {{ product.variants | json }}
</script>

{% schema %}
{
  "name": "Stock status",
  "target": "section",
  "templates": ["product"],
  "stylesheet": "stock-status.css",
  "javascript": "stock-status.js",
  "settings": [
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Low stock threshold",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 5
    }
  ]
}
{% endschema %}
